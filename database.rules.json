{
  "rules": {
    "rooms": {
      "$code": {
        ".read": "auth != null",
        ".write": "auth != null && (!data.exists() || data.child('hostUid').val() === auth.uid)",
        ".validate": "newData.hasChildren(['status', 'hostUid'])",
        "fighters": {
          "$pid": {
            ".write": "auth != null && $pid === auth.uid && !data.exists() && root.child('rooms').child($code).child('status').val() === 'lobby'"
          }
        }
      }
    },
    "answers": {
      "$code": {
        ".read": "auth != null && root.child('rooms').child($code).child('hostUid').val() === auth.uid",
        ".write": "auth != null && root.child('rooms').child($code).child('hostUid').val() === auth.uid",
        "$round": {
          "$pid": {
            ".write": "auth != null && $pid === auth.uid && !data.exists() && root.child('rooms').child($code).child('status').val() === 'playing'"
          }
        }
      }
    },
    "sets": {
      "$code": {
        ".read": "auth != null",
        ".write": "auth != null && !data.exists()"
      }
    }
  }
}
